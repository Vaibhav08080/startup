# --- LLM (any OpenAI-compatible API: OpenAI, Groq (free tier), OpenRouter, Together...) ---
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile

# --- Gmail (Google Account -> Security -> 2FA on -> App passwords) ---
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# --- Contact finding (optional but MUCH better hit rate) ---
HUNTER_API_KEY=          # hunter.io free: 25 searches + 50 verifications / month

# --- Typefully (Settings -> API -> create key with publish access) ---
TYPEFULLY_API_KEY=
TYPEFULLY_SOCIAL_SET_ID=      # id of @Vaibhaavvvvvv once added in Typefully

# --- Discord: webhook in #job-hunt so scout channel sees every action ---
DISCORD_WEBHOOK_URL=

# --- Optional ---
GITHUB_TOKEN=            # raises GitHub API rate limit for yap context

# true = write emails to ./outbox and Discord, send nothing. Flip to false after you've seen 5-10 drafts.
DRY_RUN=true
